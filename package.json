{
    "name": "coding-plans-for-copilot",
    "displayName": "%displayName%",
    "description": "%description%",
    "version": "0.18.0",
    "publisher": "techfetch-dev",
    "activationEvents": [
        "onStartupFinished"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/jqknono/coding-plans-for-copilot.git"
    },
    "engines": {
        "vscode": "^1.142.0"
    },
    "categories": [
        "Machine Learning",
        "Other"
    ],
    "icon": "assets/icon.png",
    "main": "./out/extension.node.js",
    "browser": "./out/extension.web.js",
    "contributes": {
        "languageModelChatProviders": [
            {
                "vendor": "coding-plans",
                "displayName": "%providers.codingPlans.displayName%",
                "configuration": {
                    "type": "object",
                    "properties": {
                        "vendorName": {
                            "type": "string",
                            "title": "%providers.codingPlans.config.vendorName.title%",
                            "description": "%providers.codingPlans.config.vendorName.description%"
                        },
                        "apiKey": {
                            "type": "string",
                            "secret": true,
                            "title": "%providers.codingPlans.config.apiKey.title%",
                            "description": "%providers.codingPlans.config.apiKey.description%"
                        }
                    }
                }
            }
        ],
        "viewsContainers": {
            "panel": [
                {
                    "id": "coding-plans-terminalIntent",
                    "title": "%viewsContainers.coding-plans.terminalIntent.title%",
                    "icon": "assets/icon.svg"
                }
            ]
        },
        "views": {
            "coding-plans-terminalIntent": [
                {
                    "type": "webview",
                    "id": "coding-plans-terminalIntent-view",
                    "name": "%views.coding-plans.terminalIntent.view.name%",
                    "icon": "assets/icon.svg"
                }
            ]
        },
        "commands": [
            {
                "command": "coding-plans.manage",
                "title": "%commands.coding-plans.manage.title%",
                "category": "%commands.category%"
            },
            {
                "command": "coding-plans.refreshModels",
                "title": "%commands.coding-plans.refreshModels.title%",
                "category": "%commands.category%"
            },
            {
                "command": "coding-plans.updateModels",
                "title": "%commands.coding-plans.updateModels.title%",
                "category": "%commands.category%"
            },
            {
                "command": "coding-plans.copyModelAsChatLanguageModel",
                "title": "%commands.coding-plans.copyModelAsChatLanguageModel.title%",
                "category": "%commands.category%"
            },
            {
                "command": "coding-plans.generateCommitMessage",
                "title": "%commands.coding-plans.generateCommitMessage.title%",
                "icon": "$(sparkle)",
                "category": "%commands.category%"
            },
            {
                "command": "coding-plans.selectCommitMessageModel",
                "title": "%commands.coding-plans.selectCommitMessageModel.title%",
                "category": "%commands.category%"
            },
            {
                "command": "coding-plans.terminalIntent.focus",
                "title": "%commands.coding-plans.terminalIntent.focus.title%",
                "category": "%commands.category%"
            },
            {
                "command": "coding-plans.terminalIntent.clear",
                "title": "%commands.coding-plans.terminalIntent.clear.title%",
                "icon": "$(clear-all)",
                "category": "%commands.category%"
            }
        ],
        "menus": {
            "scm/title": [
                {
                    "command": "coding-plans.generateCommitMessage",
                    "group": "navigation",
                    "when": "scmProvider == git && config.coding-plans.commitMessage.showGenerateCommand"
                }
            ],
            "view/title": [
                {
                    "command": "coding-plans.terminalIntent.clear",
                    "when": "view == coding-plans-terminalIntent-view",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "coding-plans.generateCommitMessage",
                    "when": "config.coding-plans.commitMessage.showGenerateCommand"
                }
            ]
        },
        "configuration": {
            "title": "%configuration.title%",
            "properties": {
                "coding-plans.commitMessage.showGenerateCommand": {
                    "type": "boolean",
                    "default": true,
                    "description": "%configuration.coding-plans.commitMessage.showGenerateCommand.description%",
                    "order": 0
                },
                "coding-plans.commitMessage.language": {
                    "type": "string",
                    "default": "en",
                    "enum": [
                        "en",
                        "zh-cn"
                    ],
                    "enumDescriptions": [
                        "English",
                        "中文"
                    ],
                    "description": "%configuration.coding-plans.commitMessage.language.description%",
                    "order": 1
                },
                "coding-plans.commitMessage.useRecentCommitStyle": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.coding-plans.commitMessage.useRecentCommitStyle.description%",
                    "order": 2
                },
                "coding-plans.commitMessage.modelVendor": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.coding-plans.commitMessage.modelVendor.description%",
                    "order": 3
                },
                "coding-plans.commitMessage.modelId": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.coding-plans.commitMessage.modelId.description%",
                    "order": 4
                },
                "coding-plans.commitMessage.options": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "prompt": {
                            "type": "string"
                        },
                        "maxDiffLines": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "pipelineMode": {
                            "type": "string",
                            "enum": [
                                "single",
                                "two-stage",
                                "auto"
                            ]
                        },
                        "summaryTriggerLines": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "summaryChunkLines": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "summaryMaxChunks": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "maxBodyBulletCount": {
                            "type": "integer",
                            "minimum": 2
                        },
                        "subjectMaxLength": {
                            "type": "integer",
                            "minimum": 20
                        },
                        "requireConventionalType": {
                            "type": "boolean"
                        },
                        "warnOnValidationFailure": {
                            "type": "boolean"
                        },
                        "llmMaxPromptLength": {
                            "type": "integer",
                            "minimum": 500
                        }
                    },
                    "default": {
                        "prompt": "FORMAT REQUIREMENT:\nFollow the Conventional Commits format: <type>(<scope>): <description>.\nCommon types: feat, fix, docs, style, refactor, perf, test, build, ci, chore.\nOutput ONLY the commit message, no explanation, no markdown fences.",
                        "maxDiffLines": 10000,
                        "pipelineMode": "single",
                        "summaryTriggerLines": 1200,
                        "summaryChunkLines": 800,
                        "summaryMaxChunks": 12,
                        "maxBodyBulletCount": 5,
                        "subjectMaxLength": 72,
                        "requireConventionalType": true,
                        "warnOnValidationFailure": true,
                        "llmMaxPromptLength": 60000
                    },
                    "description": "%configuration.coding-plans.commitMessage.options.description%",
                    "order": 5
                },
                "coding-plans.logLevel": {
                    "type": "string",
                    "scope": "window",
                    "default": "warn",
                    "enum": [
                        "trace",
                        "debug",
                        "info",
                        "warn",
                        "error",
                        "off"
                    ],
                    "enumDescriptions": [
                        "Show all logs, including request message content previews.",
                        "Show detailed diagnostics without request message content previews.",
                        "Show informational logs, warnings, and errors.",
                        "Show only warnings and errors.",
                        "Show only errors.",
                        "Disable Coding Plans logs."
                    ],
                    "description": "%configuration.coding-plans.logLevel.description%",
                    "order": 7
                },
                "coding-plans.locale": {
                    "type": "string",
                    "default": "",
                    "enum": [
                        "",
                        "zh-CN",
                        "en-US"
                    ],
                    "enumDescriptions": [
                        "%configuration.coding-plans.locale.default%",
                        "%configuration.coding-plans.locale.zhCN%",
                        "%configuration.coding-plans.locale.enUS%"
                    ],
                    "description": "%configuration.coding-plans.locale.description%",
                    "order": 6
                },
                "coding-plans.autoRefreshModels": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.coding-plans.autoRefreshModels.description%",
                    "order": 10
                },
                "coding-plans.terminalIntent.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "%configuration.coding-plans.terminalIntent.enabled.description%",
                    "order": 11
                },
                "coding-plans.terminalIntent.maxEntries": {
                    "type": "integer",
                    "default": 10,
                    "minimum": 1,
                    "description": "%configuration.coding-plans.terminalIntent.maxEntries.description%",
                    "order": 12
                },
                "coding-plans.vendors": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "baseUrl",
                            "useModelsEndpoint"
                        ],
                        "properties": {
                            "name": {
                                "type": "string",
                                "pattern": "\\S"
                            },
                            "baseUrl": {
                                "type": "string",
                                "pattern": "\\S"
                            },
                            "authType": {
                                "type": "string",
                                "enum": [
                                    "bearer",
                                    "x-api-key"
                                ],
                                "description": "Optional authentication header override for chat and /models discovery. When omitted, Anthropic uses x-api-key and OpenAI uses Authorization: Bearer. Explicit values send only the selected auth header; Anthropic always keeps anthropic-version. Does not change usageUrl authentication."
                            },
                            "usageUrl": {
                                "type": "string",
                                "description": "Optional vendor usage endpoint. When configured, the extension fetches coding-plan quota usage and shows percentage summaries in the status bar. Currently verified for Zhipu usage APIs.",
                                "pattern": "\\S"
                            },
                            "useModelsEndpoint": {
                                "type": "boolean",
                                "default": true,
                                "description": "When true, fetch model list from /models during refresh."
                            },
                            "defaultVision": {
                                "type": "boolean",
                                "default": false,
                                "description": "Whether newly discovered models for this vendor should have vision capabilities by default."
                            },
                            "models": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "name"
                                    ],
                                    "properties": {
                                        "name": {
                                            "type": "string",
                                            "pattern": "\\S"
                                        },
                                        "enabled": {
                                            "type": "boolean",
                                            "default": true,
                                            "description": "%configuration.coding-plans.vendors.models.enabled.description%"
                                        },
                                        "description": {
                                            "type": "string"
                                        },
                                        "capabilities": {
                                            "type": "object",
                                            "properties": {
                                                "tools": {
                                                    "type": "boolean",
                                                    "default": true,
                                                    "description": "Whether to enable tool calling capability."
                                                },
                                                "vision": {
                                                    "type": "boolean",
                                                    "default": false,
                                                    "description": "Whether to enable vision input capability."
                                                },
                                                "thinking": {
                                                    "type": "boolean",
                                                    "default": true,
                                                    "description": "Whether to expose and send reasoning/thinking controls for this model."
                                                }
                                            },
                                            "additionalProperties": false
                                        },
                                        "contextWindow": {
                                            "type": "integer",
                                            "minimum": 2,
                                            "title": "%configuration.coding-plans.vendors.models.contextWindow.title%",
                                            "description": "%configuration.coding-plans.vendors.models.contextWindow.description%"
                                        },
                                        "maxInputTokens": {
                                            "type": "integer",
                                            "minimum": 1,
                                            "title": "%configuration.coding-plans.vendors.models.maxInputTokens.title%",
                                            "description": "%configuration.coding-plans.vendors.models.maxInputTokens.description%"
                                        },
                                        "maxOutputTokens": {
                                            "type": "integer",
                                            "minimum": 1,
                                            "title": "%configuration.coding-plans.vendors.models.maxOutputTokens.title%",
                                            "description": "%configuration.coding-plans.vendors.models.maxOutputTokens.description%"
                                        },
                                        "contextBudget": {
                                            "type": "object",
                                            "title": "%configuration.coding-plans.vendors.models.contextBudget.title%",
                                            "additionalProperties": false,
                                            "description": "%configuration.coding-plans.vendors.models.contextBudget.description%",
                                            "defaultSnippets": [
                                                {
                                                    "label": "%configuration.coding-plans.vendors.models.contextBudget.snippet.label%",
                                                    "body": {
                                                        "inputTokens": 64000,
                                                        "outputTokens": 16000
                                                    }
                                                }
                                            ],
                                            "properties": {
                                                "inputTokens": {
                                                    "type": "integer",
                                                    "minimum": 1,
                                                    "description": "%configuration.coding-plans.vendors.models.contextBudget.inputTokens.description%"
                                                },
                                                "outputTokens": {
                                                    "type": "integer",
                                                    "minimum": 1,
                                                    "description": "%configuration.coding-plans.vendors.models.contextBudget.outputTokens.description%"
                                                },
                                                "presets": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "integer",
                                                        "minimum": 1
                                                    },
                                                    "description": "%configuration.coding-plans.vendors.models.contextBudget.presets.description%"
                                                }
                                            }
                                        },
                                        "limitSource": {
                                            "type": "string",
                                            "title": "%configuration.coding-plans.vendors.models.limitSource.title%",
                                            "doNotSuggest": true,
                                            "enum": [
                                                "configured",
                                                "endpoint",
                                                "models.dev"
                                            ],
                                            "description": "%configuration.coding-plans.vendors.models.limitSource.description%"
                                        },
                                        "apiStyle": {
                                            "type": "string",
                                            "enum": [
                                                "chat-completions",
                                                "responses",
                                                "messages"
                                            ],
                                            "description": "Optional per-model API protocol style. When set, it overrides the vendor defaultApiStyle. For responses models, request usage is read from the /responses result when available."
                                        },
                                        "streaming": {
                                            "type": "boolean",
                                            "default": true,
                                            "description": "Whether this model should use streaming requests when supported."
                                        },
                                        "editTools": {
                                            "type": "array",
                                            "items": {
                                                "type": "string",
                                                "pattern": "\\S"
                                            },
                                            "default": [
                                                "apply-patch",
                                                "multi-find-replace",
                                                "find-replace",
                                                "code-rewrite"
                                            ],
                                            "description": "Copilot-style edit tools supported by this model."
                                        },
                                        "supportsReasoningEffort": {
                                            "type": "array",
                                            "items": {
                                                "type": "string",
                                                "enum": [
                                                    "none",
                                                    "low",
                                                    "medium",
                                                    "high",
                                                    "xhigh",
                                                    "max"
                                                ]
                                            },
                                            "description": "Allowed reasoning effort values for this model. When set, More Actions and request payloads are limited to these values."
                                        },
                                        "reasoningEffortFormat": {
                                            "type": "string",
                                            "enum": [
                                                "chat-completions",
                                                "responses"
                                            ],
                                            "description": "Copilot-style reasoning effort wire format metadata: chat-completions or responses. Defaults to the selected API style when omitted; messages uses Anthropic thinking controls."
                                        },
                                        "zeroDataRetentionEnabled": {
                                            "type": "boolean",
                                            "description": "Declarative Copilot-style metadata. This does not change upstream provider retention behavior."
                                        },
                                        "price": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "description": "Cost metadata shown in Manage Language Models. Values are credits per 1M tokens.",
                                            "properties": {
                                                "inputCost": {
                                                    "type": "number",
                                                    "minimum": 0,
                                                    "description": "Input cost in credits per 1M tokens."
                                                },
                                                "cacheCost": {
                                                    "type": "number",
                                                    "minimum": 0,
                                                    "description": "Cached input cost in credits per 1M tokens."
                                                },
                                                "outputCost": {
                                                    "type": "number",
                                                    "minimum": 0,
                                                    "description": "Output cost in credits per 1M tokens."
                                                },
                                                "longContextInputCost": {
                                                    "type": "number",
                                                    "minimum": 0,
                                                    "description": "Long-context input cost in credits per 1M tokens shown in model hover details when supported by VS Code."
                                                },
                                                "longContextCacheCost": {
                                                    "type": "number",
                                                    "minimum": 0,
                                                    "description": "Long-context cached input cost in credits per 1M tokens shown in model hover details when supported by VS Code."
                                                },
                                                "longContextOutputCost": {
                                                    "type": "number",
                                                    "minimum": 0,
                                                    "description": "Long-context output cost in credits per 1M tokens shown in model hover details when supported by VS Code."
                                                }
                                            }
                                        }
                                    },
                                    "additionalProperties": false
                                },
                                "default": []
                            },
                            "defaultApiStyle": {
                                "type": "string",
                                "enum": [
                                    "chat-completions",
                                    "responses",
                                    "messages"
                                ],
                                "default": "chat-completions",
                                "description": "Default API protocol style for this vendor. Models can override it with models[].apiStyle. Use chat-completions for /chat/completions, responses for /responses, or messages for /messages-compatible endpoints. For responses models, request usage is read from the /responses result when available."
                            }
                        },
                        "additionalProperties": false
                    },
                    "default": [
                        {
                            "name": "Zhipu",
                            "baseUrl": "https://open.bigmodel.cn/api/coding/paas/v4",
                            "usageUrl": "https://open.bigmodel.cn/api/monitor/usage/quota/limit",
                            "defaultApiStyle": "chat-completions",
                            "defaultVision": false,
                            "useModelsEndpoint": true,
                            "models": []
                        },
                        {
                            "name": "火山引擎",
                            "baseUrl": "https://ark.cn-beijing.volces.com/api/coding/v3",
                            "models": [
                                {
                                    "name": "doubao-seed-evolving"
                                },
                                {
                                    "name": "doubao-seed-2.1-turbo"
                                },
                                {
                                    "name": "doubao-seed-2.0-lite"
                                },
                                {
                                    "name": "minimax-m3"
                                },
                                {
                                    "name": "glm-5.3"
                                },
                                {
                                    "name": "glm-5.3-flash"
                                },
                                {
                                    "name": "deepseek-v4-flash"
                                },
                                {
                                    "name": "deepseek-v4-pro"
                                },
                                {
                                    "name": "kimi-k2.7-code"
                                },
                                {
                                    "name": "kimi-k3"
                                }
                            ],
                            "useModelsEndpoint": false,
                            "defaultApiStyle": "responses"
                        },
                        {
                            "name": "Kimi",
                            "baseUrl": "https://api.kimi.com/coding/v1",
                            "models": [],
                            "useModelsEndpoint": true,
                            "defaultApiStyle": "messages"
                        },
                        {
                            "name": "Aliyun",
                            "baseUrl": "https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic",
                            "models": [],
                            "useModelsEndpoint": true,
                            "defaultApiStyle": "messages"
                        },
                        {
                            "name": "OpenRouter",
                            "baseUrl": "https://openrouter.ai/api",
                            "models": [],
                            "useModelsEndpoint": true,
                            "defaultApiStyle": "messages"
                        },
                        {
                            "name": "Tencent",
                            "baseUrl": "https://api.lkeap.cloud.tencent.com/plan/anthropic",
                            "models": [],
                            "useModelsEndpoint": true,
                            "defaultApiStyle": "messages"
                        },
                        {
                            "name": "Xiaomi MiMo",
                            "baseUrl": "https://token-plan-cn.xiaomimimo.com/anthropic",
                            "models": [],
                            "useModelsEndpoint": true,
                            "defaultApiStyle": "messages"
                        },
                        {
                            "name": "DeepSeek",
                            "baseUrl": "https://api.deepseek.com/anthropic",
                            "models": [],
                            "useModelsEndpoint": true,
                            "defaultApiStyle": "messages"
                        }
                    ],
                    "description": "%configuration.coding-plans.vendors.description%",
                    "order": 7
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "typecheck": "tsc -p ./ --noEmit",
        "bundle": "node ./scripts/esbuild.js",
        "bundle:prod": "node ./scripts/esbuild.js --production",
        "compile": "npm run typecheck && npm run bundle",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "format": "prettier --write \"**/*.{js,ts}\"",
        "format:check": "prettier --check \"**/*.{js,ts}\"",
        "test": "npm run test:unit && npm run test:desktop",
        "test:unit": "node ./out/test/runTest.js",
        "test:desktop": "vscode-test --label desktop",
        "test:vsix": "node --test tests/scripts/vsix-package-files.test.js",
        "package": "npm run bundle:prod",
        "package:vsix": "npm run package && npm run test:vsix && npx @vscode/vsce package",
        "package:vsix:pre": "npm run package && npm run test:vsix && npx @vscode/vsce package --pre-release",
        "publish:marketplace": "npm run package && npx @vscode/vsce publish",
        "publish:marketplace:pre": "npm run package && npx @vscode/vsce publish --pre-release",
        "pricing:fetch": "node ./scripts/fetch-provider-pricing.js",
        "metrics:fetch": "node ./scripts/fetch-openrouter-provider-metrics.js",
        "openrouter:plans:fetch": "node ./scripts/fetch-openrouter-provider-plans.js",
        "serve:page": "node ./scripts/serve-pricing-page.js",
        "test:pages": "playwright test --config=playwright.config.ts",
        "test:pages:headed": "playwright test --config=playwright.config.ts --headed",
        "crawler:run": "node ./scripts/crawler/index.js --days=1",
        "crawler:run:publish": "node ./scripts/crawler/index.js --days=1 --discussion",
        "crawler:v2ex": "node ./scripts/crawler/index.js --source=v2ex --days=1",
        "crawler:v2ex:publish": "node ./scripts/crawler/index.js --source=v2ex --days=1 --discussion",
        "crawler:linuxdo": "node ./scripts/crawler/index.js --source=linuxdo --days=1",
        "crawler:linuxdo:publish": "node ./scripts/crawler/index.js --source=linuxdo --days=1 --discussion",
        "crawler:migrate-discussion-labels": "node ./scripts/discussions/migrate-discussion-labels.js",
        "crawler:verify-discussion-labels": "node ./scripts/discussions/verify-discussion-labels.js",
        "crawler:cleanup-discussions": "node ./scripts/discussions/cleanup-discussions.js",
        "crawler:setup-categories": "node ./scripts/discussions/setup-discussion-categories.js"
    },
    "devDependencies": {
        "@playwright/test": "1.58.2",
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.14.9",
        "@types/vscode": "^1.120.0",
        "@typescript-eslint/eslint-plugin": "^7.13.1",
        "@typescript-eslint/parser": "^7.13.1",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "esbuild": "^0.25.10",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^10.1.8",
        "typescript": "^5.4.5"
    },
    "dependencies": {
        "axios": "^1.7.2"
    }
}
